{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "An item: data/items/<item>/data.json",
    "description": "One item's file in ARCID_ITEMINFO (archive a/0/2/4, 36 bytes, ItemData in include/pml/item.h), with its name and description. tools/data/item_data.py packs them in the order of data/constants/items.txt. A string value is the name of a constant from data/constants/ or include/constants/.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name", "name_plural", "description", "price", "hold_effect", "hold_param", "pluck_effect", "fling_effect",
        "fling_power", "natural_gift_power", "natural_gift_type", "important", "registrable", "field_pocket",
        "battle_pocket", "field_func", "battle_func", "kind", "unk_e", "sort_index"
    ],
    "properties": {
        "$schema": { "type": "string", "description": "This schema, for editors" },
        "name": {
            "type": "string",
            "description": "The item's name, which the text files take with \\from{items.name}, also with its article"
        },
        "name_article": {
            "type": "string",
            "description": "The article of the name where it isn't \"an\" before a vowel and \"a\" before anything else: \"an\" for HP Up and the X items, which go by their sound, \"the\" for Leftovers, and \"\" for none, as for Honey"
        },
        "name_with_article": {
            "type": "string",
            "description": "The whole name with its article, for an item whose isn't written as the others' are: Oak's Letter and most unused items have neither the article nor the codes around it"
        },
        "name_plural": { "type": "string", "description": "The name for more than one, which the text files take with \\from{items.name_plural}" },
        "description": { "type": "string", "description": "The item's description, with its line breaks" },
        "price": {
            "$ref": "#/$defs/u16",
            "description": "In tens of Pokédollars: 30 for a Potion, which costs 300 (PML_ItemGetParam multiplies it by 10)"
        },
        "hold_effect": {
            "type": [ "string", "integer" ], "x-constant": "HOLD_EFFECT_", "minimum": 0, "maximum": 255,
            "description": "The effect of holding it, a HOLD_EFFECT_* constant"
        },
        "hold_param": { "$ref": "#/$defs/u8", "description": "The hold effect's parameter" },
        "pluck_effect": { "$ref": "#/$defs/u8", "description": "The effect of a berry eaten by Pluck or Bug Bite" },
        "fling_effect": { "$ref": "#/$defs/u8", "description": "The effect of Fling with the item" },
        "fling_power": { "$ref": "#/$defs/u8" },
        "natural_gift_power": { "$ref": "#/$defs/u8" },
        "natural_gift_type": {
            "type": [ "string", "null" ], "x-constant": "TYPE_",
            "description": "The type of Natural Gift with the item, or null for an item it doesn't work with"
        },
        "important": { "type": "boolean", "description": "A key item, which can't be sold or tossed" },
        "registrable": { "type": "boolean", "description": "Whether it can be registered to the Y button" },
        "field_pocket": {
            "type": "string", "x-constant": "BAG_POCKET_",
            "description": "The bag pocket outside battle, a BAG_POCKET_* constant"
        },
        "battle_pocket": {
            "type": "array", "items": { "type": [ "string", "integer" ], "x-constant": "BATTLE_POCKET_", "minimum": 0 },
            "description": "The pockets of the battle bag it is in, BATTLE_POCKET_* constants; none for an item that isn't used in battle"
        },
        "field_func": { "$ref": "#/$defs/u8", "description": "What using it outside battle does, by number" },
        "battle_func": { "$ref": "#/$defs/u8", "description": "What using it in battle does, by number" },
        "kind": { "$ref": "#/$defs/u8", "description": "The item's kind, which the bag sorts by first" },
        "unk_e": { "$ref": "#/$defs/u8" },
        "sort_index": { "$ref": "#/$defs/u8", "description": "The item's place in the bag's sort within its kind" },
        "value": {
            "$ref": "#/$defs/u8",
            "description": "The item's single value (ITEM_WORK_VALUE). An item has this or effects"
        },
        "effects": {
            "type": "object", "additionalProperties": false,
            "description": "What the item does used on a Pokémon (ITEM_WORK_PARAMS, ItemParams in include/pml/item.h). An item has this or value",
            "required": [
                "sleep_heal", "poison_heal", "burn_heal", "freeze_heal", "paralysis_heal", "confusion_heal",
                "infatuation_heal", "guard_spec", "revive", "revive_all", "level_up", "evolve", "attack_stages",
                "defense_stages", "sp_attack_stages", "sp_defense_stages", "speed_stages", "accuracy_stages",
                "crit_stages", "pp_up", "pp_max", "pp_restore", "pp_restore_all", "hp_restore", "hp_ev_up",
                "attack_ev_up", "defense_ev_up", "speed_ev_up", "sp_attack_ev_up", "sp_defense_ev_up",
                "friendship_up_1", "friendship_up_2", "friendship_up_3", "unk6_4", "hp_ev", "attack_ev",
                "defense_ev", "speed_ev", "sp_attack_ev", "sp_defense_ev", "hp_restore_amount", "pp_restore_amount",
                "friendship_1", "friendship_2", "friendship_3"
            ],
            "properties": {
                "sleep_heal": { "type": "boolean" },
                "poison_heal": { "type": "boolean" },
                "burn_heal": { "type": "boolean" },
                "freeze_heal": { "type": "boolean" },
                "paralysis_heal": { "type": "boolean" },
                "confusion_heal": { "type": "boolean" },
                "infatuation_heal": { "type": "boolean" },
                "guard_spec": { "type": "boolean" },
                "revive": { "type": "boolean" },
                "revive_all": { "type": "boolean" },
                "level_up": { "type": "boolean" },
                "evolve": { "type": "boolean" },
                "attack_stages": { "$ref": "#/$defs/u4" },
                "defense_stages": { "$ref": "#/$defs/u4" },
                "sp_attack_stages": { "$ref": "#/$defs/u4" },
                "sp_defense_stages": { "$ref": "#/$defs/u4" },
                "speed_stages": { "$ref": "#/$defs/u4" },
                "accuracy_stages": { "$ref": "#/$defs/u4" },
                "crit_stages": { "type": "integer", "minimum": 0, "maximum": 3 },
                "pp_up": { "type": "boolean" },
                "pp_max": { "type": "boolean" },
                "pp_restore": { "type": "boolean" },
                "pp_restore_all": { "type": "boolean" },
                "hp_restore": { "type": "boolean" },
                "hp_ev_up": { "type": "boolean" },
                "attack_ev_up": { "type": "boolean" },
                "defense_ev_up": { "type": "boolean" },
                "speed_ev_up": { "type": "boolean" },
                "sp_attack_ev_up": { "type": "boolean" },
                "sp_defense_ev_up": { "type": "boolean" },
                "friendship_up_1": { "type": "boolean" },
                "friendship_up_2": { "type": "boolean" },
                "friendship_up_3": { "type": "boolean" },
                "unk6_4": { "type": "boolean" },
                "hp_ev": { "$ref": "#/$defs/s8" },
                "attack_ev": { "$ref": "#/$defs/s8" },
                "defense_ev": { "$ref": "#/$defs/s8" },
                "speed_ev": { "$ref": "#/$defs/s8" },
                "sp_attack_ev": { "$ref": "#/$defs/s8" },
                "sp_defense_ev": { "$ref": "#/$defs/s8" },
                "hp_restore_amount": { "$ref": "#/$defs/u8" },
                "pp_restore_amount": { "$ref": "#/$defs/u8" },
                "friendship_1": { "$ref": "#/$defs/s8" },
                "friendship_2": { "$ref": "#/$defs/s8" },
                "friendship_3": { "$ref": "#/$defs/s8" }
            }
        }
    },
    "$defs": {
        "u4": { "type": "integer", "minimum": 0, "maximum": 15 },
        "u8": { "type": "integer", "minimum": 0, "maximum": 255 },
        "s8": { "type": "integer", "minimum": -128, "maximum": 127 },
        "u16": { "type": "integer", "minimum": 0, "maximum": 65535 }
    }
}

{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "A lighting set: data/lights/field/<n>.json or data/lights/battle/<n>.json",
    "description": "A file of ARCID_LIGHTS_FIELD (a/0/6/0), which an area names by its lights, or of ARCID_LIGHTS_BATTLE (a/0/6/1): the lighting through the day, an entry per period, which FieldLight_FlushCore applies. tools/data/light_data.py packs them in order.",
    "type": "object",
    "additionalProperties": false,
    "required": [ "periods" ],
    "properties": {
        "$schema": { "type": "string", "description": "This schema, for editors" },
        "periods": {
            "type": "array",
            "description": "The periods of the day, in order; each lasts until its end",
            "items": {
                "type": "object", "additionalProperties": false,
                "required": [ "end", "lights", "diffuse", "ambient", "specular", "emission", "fog", "clear" ],
                "properties": {
                    "end": {
                        "type": "object", "additionalProperties": false, "required": [ "hour", "minutes" ],
                        "description": "When the period ends: an hour of the season's table (GetLightChangeHoursForSeasons) and minutes after it (FieldLight_GetLightEndSecond)",
                        "properties": { "hour": { "type": "integer", "minimum": 0, "maximum": 65535 }, "minutes": { "type": "integer", "minimum": -32768, "maximum": 32767 } }
                    },
                    "lights": {
                        "type": "array", "minItems": 4, "maxItems": 4,
                        "items": {
                            "type": "object", "additionalProperties": false, "required": [ "enabled", "color", "direction" ],
                            "properties": {
                                "enabled": { "type": "boolean" },
                                "color": { "$ref": "#/$defs/color" },
                                "direction": {
                                    "type": "object", "additionalProperties": false, "required": [ "x", "y", "z" ],
                                    "description": "In 4096ths, as the fixed-point numbers the game keeps (it normalizes them when it loads them)",
                                    "properties": { "x": { "$ref": "#/$defs/fx16" }, "y": { "$ref": "#/$defs/fx16" }, "z": { "$ref": "#/$defs/fx16" } }
                                }
                            }
                        }
                    },
                    "diffuse": { "$ref": "#/$defs/color", "description": "The materials' diffuse color" },
                    "ambient": { "$ref": "#/$defs/color", "description": "The materials' ambient color" },
                    "specular": { "$ref": "#/$defs/color", "description": "The materials' specular color" },
                    "emission": { "$ref": "#/$defs/color", "description": "The materials' emission color" },
                    "fog": { "$ref": "#/$defs/color", "description": "The fog's color" },
                    "clear": { "$ref": "#/$defs/color", "description": "The color the screen clears to" }
                }
            }
        }
    },
    "$defs": {
        "color": {
            "type": "object", "additionalProperties": false, "required": [ "red", "green", "blue" ],
            "description": "A color, 0 to 31 for each component",
            "properties": {
                "red": { "type": "integer", "minimum": 0, "maximum": 31 },
                "green": { "type": "integer", "minimum": 0, "maximum": 31 },
                "blue": { "type": "integer", "minimum": 0, "maximum": 31 }
            }
        },
        "fx16": { "type": "integer", "minimum": -32768, "maximum": 32767 }
    }
}

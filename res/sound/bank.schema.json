{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "A sound bank: res/sound/banks/<category>/<name>/data.json",
    "description": "A bank's info record in the sound archive (swan_sound_data.sdat) and its instruments, which tools/data/sound_data.py packs in the order of generated/sound_banks.txt (tools/data/sbnk.py writes the bank). A bank with file uses another's instruments.",
    "type": "object",
    "additionalProperties": false,
    "required": [ "wave_archives" ],
    "properties": {
        "$schema": { "type": "string", "description": "This schema, for editors" },
        "file": { "type": "string", "x-constant": "BANK_", "description": "The bank whose instruments this one uses, when it has none of its own" },
        "wave_archives": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": { "type": [ "string", "null" ], "x-constant": "WAVE_" },
            "description": "The four wave archives whose samples its instruments play, null for none"
        },
        "instruments": {
            "type": "array",
            "description": "The instruments, in the order of their data, each with the program number that a sequence's program picks it by",
            "items": {
                "anyOf": [
                    { "$ref": "#/$defs/programmed" },
                    {
                        "type": "object", "additionalProperties": false, "required": [ "unused" ],
                        "properties": { "unused": { "type": "string", "pattern": "^([0-9a-f]{2})*$", "description": "Data that no program uses, as hex" } }
                    },
                    {
                        "type": "object", "additionalProperties": false, "required": [ "programs" ],
                        "properties": { "programs": { "type": "integer", "minimum": 0, "maximum": 65535, "description": "How many programs the bank has, where that's more than its last instrument's" } }
                    }
                ]
            }
        }
    },
    "$defs": {
        "u8": { "type": "integer", "minimum": 0, "maximum": 255 },
        "key": { "type": [ "string", "integer" ], "description": "A key, as C4 (60) or a number" },
        "program": {
            "anyOf": [
                { "type": "integer", "minimum": 0, "maximum": 65535 },
                { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 65535 } }
            ],
            "description": "The program number, or the numbers that share this instrument"
        },
        "instrument": {
            "type": "object", "additionalProperties": false,
            "required": [ "type", "base_key", "attack", "decay", "sustain", "release", "pan" ],
            "properties": {
                "type": { "enum": [ "wave", "psg", "noise" ], "description": "A wave of a wave archive, a PSG square wave, or noise" },
                "up_to": { "$ref": "#/$defs/key", "description": "In a split, the highest key of its region" },
                "wave_archive": { "type": "string", "x-constant": "WAVE_", "description": "A wave's archive, one of the bank's wave_archives" },
                "wave": { "type": "integer", "minimum": 0, "maximum": 65535, "description": "A wave's number in its archive" },
                "duty": { "type": "integer", "minimum": 0, "maximum": 7, "description": "A PSG square wave's duty" },
                "base_key": { "$ref": "#/$defs/key", "description": "The key that plays the sound at its own pitch" },
                "attack": { "$ref": "#/$defs/u8" }, "decay": { "$ref": "#/$defs/u8" }, "sustain": { "$ref": "#/$defs/u8" },
                "release": { "$ref": "#/$defs/u8" }, "pan": { "$ref": "#/$defs/u8", "description": "Its pan, 64 the middle" }
            }
        },
        "programmed": {
            "type": "object",
            "required": [ "program", "type" ],
            "properties": {
                "program": { "$ref": "#/$defs/program" },
                "type": { "enum": [ "wave", "psg", "noise", "drums", "split" ] },
                "first_key": { "$ref": "#/$defs/key", "description": "A drum set's first key" },
                "keys": { "type": "array", "items": { "$ref": "#/$defs/instrument" }, "description": "A drum set's instrument for each key from first_key" },
                "regions": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/instrument" }, "description": "A split's instruments, each for the keys up to its up_to" },
                "wave_archive": { "type": "string", "x-constant": "WAVE_" }, "wave": { "type": "integer", "minimum": 0, "maximum": 65535 },
                "duty": { "type": "integer", "minimum": 0, "maximum": 7 },
                "base_key": { "$ref": "#/$defs/key" },
                "attack": { "$ref": "#/$defs/u8" }, "decay": { "$ref": "#/$defs/u8" }, "sustain": { "$ref": "#/$defs/u8" },
                "release": { "$ref": "#/$defs/u8" }, "pan": { "$ref": "#/$defs/u8" }
            }
        }
    }
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The macOS app's Info.plist. port/app/macos/make_app.sh fills in the fields between at signs when it builds the app.

  - The names (port/cmake/macos_app.cmake): CFBundleName is the product's, Frigate, which the menu bar and the About
    window show; CFBundleDisplayName is the app's, Frigate Black 2 or Frigate White 2, which the Finder and the Dock
    show; CFBundleExecutable is the program's file, frigate-black2 or frigate-white2.
  - The bundle identifier is PORT_MACOS_BUNDLE_ID_PREFIX (CMake; io.github.callancampos.frigate) followed by the
    version's black2 or white2.
  - NSHumanReadableCopyright, which the About window shows under the name, says what Frigate is and that it is not
    affiliated with the game's owners: PORT_PRODUCT_DESCRIPTION and PORT_PRODUCT_DISCLAIMER of port/hal/os/port_app.h,
    which --help prints too.
  - CFBundleIconFile is the app's icon, Contents/Resources/AppIcon.icns, which make_app.sh copies from the .icns that
    make_icns.sh makes of the version's master in port/assets/branding (Black 2's dark plate, White 2's light one).
  - The versions come from git: CFBundleVersion is the number of commits up to the one built, which only grows along
    main, CFBundleShortVersionString is 0.0 and that number, and PortSourceRevision is the commit itself (git describe,
    with -dirty for a build of uncommitted changes).
  - LSMinimumSystemVersion is the oldest macOS the app runs on, so that an older one says so instead of failing to load
    it: the build's deployment target when it sets one (make_app.sh's --minimum, CMAKE_OSX_DEPLOYMENT_TARGET: 11.0 for
    the distribution build, ADR 0013), which no binary of the app may be built for a newer macOS than; else the newest
    macOS that the program and the libraries in the bundle were built for (their LC_BUILD_VERSION).
  - NSHighResolutionCapable gives the window a Retina backing store; the window asks SDL for its full pixel density
    (port/app/present.c).
  - LSApplicationCategoryType is a game category, and GCSupportsGameMode (macOS 14 and later) and LSSupportsGameMode
    (macOS 26) say the game supports Game Mode, which macOS may then turn on while the window is full screen: the game
    gets the performance cores first, and Bluetooth game controllers are sampled twice as often, for less input lag.
  - No usage description is needed for gamepads: SDL reads them through IOKit's HID manager and the GameController
    framework, which ask the player for nothing. The program uses no microphone, camera or Bluetooth of its own; a
    usage description goes here when it does, or macOS stops the app at its first use.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>@DISPLAY_NAME@</string>
	<key>CFBundleExecutable</key>
	<string>@EXECUTABLE@</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>@BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@BUNDLE_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@SHORT_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD_VERSION@</string>
	<key>GCSupportsGameMode</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.role-playing-games</string>
	<key>LSMinimumSystemVersion</key>
	<string>@MINIMUM_SYSTEM_VERSION@</string>
	<key>LSSupportsGameMode</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>@ABOUT@</string>
	<key>PortSourceRevision</key>
	<string>@REVISION@</string>
</dict>
</plist>

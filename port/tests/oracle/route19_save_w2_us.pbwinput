pbwinput 1
# The Route 19 save, made on the oracle from the Pokemon Center save (center_save_w2_us.pbwinput; oracle.py save
# route19_save), and phase 4's route's second piece (oracle.py's SEQUENCES: route19), which both programs play from
# that save: CONTINUE in the Pokemon Center, out into Aspertia City, Mom's scene (the Running Shoes, the Town Map), the
# gate to Route 19 and its guard's gift, Bianca's catching lesson on Route 19, a battle in which she catches a wild
# Purrloin, and the field menu's SAVE beside Route 19's grass at (56,696). The presses are those Hugh's battle's route
# from the starter save had from the Pokemon Center on, 10600 counts earlier, with B through the gate guard's words
# for 170 counts more. B advances the scenes' messages (none asks a question here) and, unlike A, starts no talk with
# whoever stands in front. The clock is pinned, and the seed lines are the random seeds the DS builds here (oracle.py
# seeds route19). Positions are zone (x, z) tiles; counts are GFL's frame count (sVBlankCount). On game frames.
# White 2, with Black 2's presses.
version w2_us
clock pinned
seed 0x270fd5258c56ebe3  # GFL's, at start-up (oracle frame 20)
seed 0xee29f8799bbac5d8  # Bianca's capture demo's (oracle frame 12038)

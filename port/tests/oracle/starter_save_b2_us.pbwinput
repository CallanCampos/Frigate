pbwinput 1
# The starter save, made on the oracle from first_save's (oracle.py save first_save): CONTINUE as the continue
# sequence presses it, then the story from the player's room to the starter at the Aspertia City lookout, and the
# field menu's SAVE. The save holds Tepig (level 5) in the party and the Pokedex: event flags 0x961 and 0x962, the
# city's story variable 0x40a1 at 4, before Hugh's battle (res/field/scripts/aspertia_city.s, Script_33 and
# Script_8). Positions are zone (x, z) tiles; counts are GFL's frame count (sVBlankCount). On game frames. Black 2.
version b2_us
# GFL's random seed as the DS builds it at start-up (oracle.py seeds starter_save): the port's game takes it in
# place of its own, so that the starter and the townspeople's walks are the DS's when the port plays this file
# from its own first save (ctest replay_starter_save); the oracle reads the line only as part of the file
seed 0xea56a175a2fffc8a
1100 START  # START in the opening skips it to the title (count 1115 on both)
1101 -
3000 START  # START brings back the layers the title hid at count 2877
3001 -
3100 START  # START leaves for the start menu, which shows from count 3249
3101 -

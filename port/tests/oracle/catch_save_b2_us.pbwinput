pbwinput 1
# The catch save, made on the oracle from the Route 19 save (route19_save_b2_us.pbwinput; oracle.py save catch_save),
# and phase 4's route's third piece (oracle.py's SEQUENCES: catch), which both programs play from that save: CONTINUE
# beside Route 19's grass, into the grass and up and down in it until a wild Pokemon appears, its battle, a Poke Ball
# from the bag, the catch, and the field menu's SAVE. The clock is pinned, and the seed lines are the random seeds the
# DS builds here (oracle.py seeds catch). Positions are zone (x, z) tiles; counts are GFL's frame count
# (sVBlankCount). On game frames. Black 2.
version b2_us
clock pinned
seed 0x5a0af77416c50a14  # GFL's, at start-up (oracle frame 20)
seed 0x078adf42ff92a496  # the wild battle's (oracle frame 7042)
1100 START  # START in the opening skips it to the title (count 1115 on both)
1101 -
3000 START  # START brings back the layers the title hid at count 2877
3001 -
3100 START  # START leaves for the start menu, which shows from count 3249
3101 -
3400 A  # CONTINUE: Route 19 (zone 437) at (56,696), beside the grass, facing it
3401 -
3900 RIGHT  # into the grass
